<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Shri Balaji Institute</title>
<style>
{{> base_styles }}

/*Welcome Banner*/
.welcome-banner {
  position: relative;
  overflow: hidden;
  border-radius: 20px;
  padding: 34px 38px;
  color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  box-shadow: 0 14px 34px rgba(0,0,0,.16);
}
.welcome-banner.basic { background: linear-gradient(135deg, #1e293b, #334155); }
.welcome-banner.premium { background: linear-gradient(135deg, #047857, #059669); }
.welcome-banner.developer { background: linear-gradient(135deg, #6d28d9, #8b5cf6); }
.welcome-banner::before, .welcome-banner::after {
  content: ""; position: absolute; border-radius: 50%;
  background: rgba(255,255,255,.08); pointer-events: none;
}
.welcome-banner::before { width: 200px; height: 200px; top: -80px; right: -50px; }
.welcome-banner::after { width: 130px; height: 130px; bottom: -60px; right: 130px; }
.welcome-text { position: relative; z-index: 1; }
.welcome-greeting { font-size: 26px; font-weight: 800; margin-bottom: 6px; }
.welcome-subtitle { font-size: 14px; opacity: .85; }
.welcome-meta {
  position: relative; z-index: 1; text-align: right; flex-shrink: 0;
}
.welcome-meta .date-day { font-size: 36px; font-weight: 800; line-height: 1; }
.welcome-meta .date-rest { font-size: 12px; opacity: .8; margin-top: 4px; }
@media (max-width: 560px) {
  .welcome-banner { flex-direction: column; align-items: flex-start; }
  .welcome-meta { text-align: left; }
}

/*Page switch (dashboard <-> material browser, within this file only)*/
.page { display: none; }
.page.active { display: block; }

/*---------------- NCERT study material ----------------*/
.material-intro { margin-top: 34px; }
.material-intro h3 { font-size: 19px; margin-bottom: 4px; }
.material-intro p { opacity: .65; font-size: 14px; margin-bottom: 18px; }
.class-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}
.class-card {
  border: none; border-radius: 16px; padding: 22px; cursor: pointer;
  color: white; text-align: left; transition: .25s ease; font-family: inherit;
}
.class-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,.22); }
.class-card:focus-visible { outline: 3px solid #facc15; outline-offset: 2px; }
.class-card .class-num { font-size: 36px; font-weight: 800; line-height: 1; }
.class-card .class-label { margin-top: 6px; font-size: 13px; opacity: .85; }

/* Class material page */
.material-card { max-width: 920px; text-align: left; }
.back-btn {
  background: transparent; border: none; cursor: pointer; font-size: 14px;
  color: inherit; opacity: .7; margin-bottom: 14px; padding: 0;
}
.back-btn:hover { opacity: 1; }
.medium-toggle {
  display: inline-flex; border-radius: 999px; overflow: hidden;
  border: 1px solid rgba(0,0,0,.15); margin: 14px 0 26px;
}
body.dark .medium-toggle { border-color: rgba(255,255,255,.18); }
.medium-toggle button {
  padding: 9px 22px; border: none; background: transparent; cursor: pointer;
  font-weight: 600; font-size: 13px; color: inherit; font-family: inherit;
}
.medium-toggle button.active { background: #1e293b; color: white; }
.subject-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 16px;
}
.subject-card { border-radius: 14px; padding: 18px 20px; background: rgba(0,0,0,.03); }
body.dark .subject-card { background: rgba(255,255,255,.05); }
.subject-card h4 { font-size: 15px; margin-bottom: 6px; }
.book-link {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 9px 0; font-size: 13px; text-decoration: none; color: inherit;
  border-top: 1px solid rgba(0,0,0,.07);
}
body.dark .book-link { border-top-color: rgba(255,255,255,.08); }
.subject-card h4 + .book-link { border-top: none; }
.book-link:hover { color: #047857; }
body.dark .book-link:hover { color: #34d399; }
.book-link .go { opacity: .5; font-size: 12px; white-space: nowrap; }
.material-note { font-size: 12px; opacity: .55; margin-top: 22px; line-height: 1.5; }

/*---------------- Add Lecture (developer only) ----------------*/
.dev-panel {
  margin-top: 34px; border-radius: 18px; padding: 26px 28px;
  background: rgba(139,92,246,.06); border: 1px solid rgba(139,92,246,.25);
}
body.dark .dev-panel { background: rgba(139,92,246,.08); border-color: rgba(139,92,246,.3); }
.dev-panel h3 {
  font-size: 17px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px;
}
.dev-badge {
  font-size: 10px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
  background: #8b5cf6; color: white; padding: 3px 8px; border-radius: 999px;
}
.dev-panel > p { opacity: .65; font-size: 13px; margin-bottom: 18px; }
.lecture-form {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 14px;
}
.lecture-form .full { grid-column: 1 / -1; }
.lecture-form label {
  display: block; font-size: 12px; font-weight: 700; margin-bottom: 6px; opacity: .8;
}
.lecture-form input,
.lecture-form select,
.lecture-form textarea {
  width: 100%; padding: 10px 12px; border-radius: 10px; font: inherit; font-size: 13px;
  border: 1px solid rgba(0,0,0,.15); background: white; color: inherit;
}
body.dark .lecture-form input,
body.dark .lecture-form select,
body.dark .lecture-form textarea {
  background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.18); color: white;
}
.lecture-form textarea { resize: vertical; min-height: 70px; }
.lecture-form .form-actions { grid-column: 1 / -1; display: flex; justify-content: space-between; }
.lecture-form button {
  border: none; border-radius: 10px; padding: 11px 22px; font: inherit; font-size: 13px;
  font-weight: 700; cursor: pointer; background: #7c3aed; color: white; transition: .2s;
}
.lecture-form button:hover:not(:disabled) { background: #6d28d9; transform: translateY(-1px); }
.lecture-form button:disabled { opacity: .6; cursor: not-allowed; transform: none; }
.dev-hint { font-size: 11px; opacity: .55; margin-top: 4px; }

/* Custom dark-themed dropdown (replaces native <select> for the class picker,
   which the browser renders with its own uncontrollable light popup styling) */
.custom-select { position: relative; }
.custom-select-trigger {
  width: 100%; padding: 10px 12px; border-radius: 10px; font: inherit; font-size: 13px;
  border: 1px solid rgba(0,0,0,.15); background: white; color: inherit;
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  cursor: pointer; text-align: left;
}
body.dark .custom-select-trigger {
  background: rgba(255,255,255,.06); border-color: rgba(255,255,255,.18); color: white;
}
.custom-select-trigger:focus-visible { outline: 2px solid #7c3aed; outline-offset: 1px; }
.custom-select-arrow { font-size: 11px; opacity: .6; transition: transform .15s ease; flex-shrink: 0; }
.custom-select.open .custom-select-arrow { transform: rotate(180deg); }
.custom-select-options {
  list-style: none; margin: 0; padding: 6px; position: absolute;
  top: calc(100% + 6px); left: 0; right: 0; z-index: 30;
  max-height: 240px; overflow-y: auto;
  border-radius: 10px; border: 1px solid rgba(0,0,0,.15);
  background: #ffffff; color: #0f172a;
  box-shadow: 0 14px 30px rgba(0,0,0,.18);
  display: none;
}
body.dark .custom-select-options {
  background: #1e1b2e; color: white; border-color: rgba(255,255,255,.18);
  box-shadow: 0 14px 30px rgba(0,0,0,.4);
}
.custom-select.open .custom-select-options { display: block; }
.custom-select-options li {
  padding: 9px 10px; border-radius: 7px; font-size: 13px; cursor: pointer;
}
.custom-select-options li:hover,
.custom-select-options li.active {
  background: #7c3aed; color: white;
}

/* Add/Edit Lecture — two-column layout with live preview */
.dev-panel-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(240px, 0.9fr);
  gap: 22px;
  align-items: start;
}
@media (max-width: 800px) {
  .dev-panel-grid { grid-template-columns: 1fr; }
}

.lecture-preview {
  border-radius: 14px;
  border: 1px solid rgba(0,0,0,.08);
  background: rgba(0,0,0,.02);
  overflow: hidden;
  position: sticky;
  top: 90px;
}
body.dark .lecture-preview {
  border-color: rgba(255,255,255,.1);
  background: rgba(255,255,255,.03);
}
.lecture-preview-thumb {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.lecture-preview-thumb img {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.lecture-preview-placeholder {
  color: rgba(255,255,255,.5);
  font-size: 12px;
  text-align: center;
  padding: 12px;
}
.lecture-preview-body { padding: 14px 16px; }
.lecture-preview-meta {
  display: flex; align-items: center; gap: 6px; margin-bottom: 8px; flex-wrap: wrap;
}
.lecture-preview-tag {
  font-size: 10px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase;
  padding: 3px 8px; border-radius: 999px; background: rgba(124,58,237,.12); color: #7c3aed;
}
.lecture-preview-tier {
  font-size: 10px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase;
  padding: 3px 8px; border-radius: 999px; background: #fef3c7; color: #92400e;
}
.lecture-preview-title {
  font-size: 15px; font-weight: 700; margin-bottom: 6px; line-height: 1.3;
}
.lecture-preview-desc {
  font-size: 12px; opacity: .65; line-height: 1.5;
}

/* Manage Lectures list */
.manage-lectures { margin-top: 30px; }
.manage-lectures-header {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  margin-bottom: 14px; flex-wrap: wrap;
}
.manage-lectures-header h4 { font-size: 14px; font-weight: 700; opacity: .85; }
.manage-lecture-row {
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  padding: 12px 14px; border-radius: 10px; background: rgba(0,0,0,.03); margin-bottom: 8px;
}
body.dark .manage-lecture-row { background: rgba(255,255,255,.05); }
.manage-lecture-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.manage-lecture-title { font-size: 13px; font-weight: 600; }
.manage-lecture-sub { font-size: 11px; opacity: .55; }
.manage-lecture-actions { display: flex; gap: 8px; flex-shrink: 0; }
.manage-lecture-actions button {
  border: none; border-radius: 8px; padding: 7px 13px; font-size: 12px; font-weight: 700;
  cursor: pointer; transition: .2s;
}
.manage-edit-btn { background: #1e293b; color: white; }
.manage-edit-btn:hover { opacity: .85; }
.manage-delete-btn { background: #ef4444; color: white; }
.manage-delete-btn:hover { background: #dc2626; }
.manage-lectures-empty { font-size: 13px; opacity: .55; padding: 16px 0; }
</style>
</head>
<body class="{{#if (equal theme "dark")}}dark{{/if}}">

{{> navbar activePage="dashboard" }}
{{> sidebar activePage="dashboard" }}

<!-- ================= Dashboard Page ================= -->
<div id="dashboardPage" class="page active">
  <div class="container">
    <div class="card welcome-banner {{tier}}">
      <div class="welcome-text">
        <h2 class="welcome-greeting"><span id="greetingWord">Hello</span>, {{username}} 👋</h2>
        <p class="welcome-subtitle">Hope you're having a productive day.</p>
      </div>
      <div class="welcome-meta" id="welcomeDate">
        <div class="date-day"></div>
        <div class="date-rest"></div>
      </div>
    </div>

    {{#if (equal tier "developer")}}
    <div class="card dev-panel">
      <h3>🛠️ Add Lecture <span class="dev-badge">Developer</span></h3>
      <p>Attach a YouTube video to a class and subject. Visible only to developer-tier accounts.</p>

      <div id="lectureFormMessage"></div>

      <div class="dev-panel-grid">
        <form class="lecture-form" id="addLectureForm">
          <input type="hidden" id="lecEditId" value="">

          <div>
            <label for="lecClassNum">Class <span style="color:#dc2626">*</span></label>
            <div class="custom-select" id="classSelect">
              <button type="button" class="custom-select-trigger" id="classSelectTrigger" aria-haspopup="listbox" aria-expanded="false">
                <span id="classSelectLabel">Select class</span>
                <span class="custom-select-arrow">▾</span>
              </button>
              <ul class="custom-select-options" id="classSelectOptions" role="listbox" tabindex="-1">
                <li role="option" data-value="1">Class 1</li>
                <li role="option" data-value="2">Class 2</li>
                <li role="option" data-value="3">Class 3</li>
                <li role="option" data-value="4">Class 4</li>
                <li role="option" data-value="5">Class 5</li>
                <li role="option" data-value="6">Class 6</li>
                <li role="option" data-value="7">Class 7</li>
                <li role="option" data-value="8">Class 8</li>
                <li role="option" data-value="9">Class 9</li>
                <li role="option" data-value="10">Class 10</li>
                <li role="option" data-value="11">Class 11</li>
                <li role="option" data-value="12">Class 12</li>
              </ul>
            </div>
            <input type="hidden" id="lecClassNum" name="classNum" required>
          </div>

          <div>
            <label for="lecSubject">Subject <span style="color:#dc2626">*</span></label>
            <input id="lecSubject" name="subject" type="text" placeholder="Mathematics" required>
          </div>

          <div class="full">
            <label for="lecTitle">Lecture Title <span style="color:#dc2626">*</span></label>
            <input id="lecTitle" name="title" type="text" placeholder="Introduction to Quadratic Equations" required>
          </div>

          <div class="full">
            <label for="lecYoutubeUrl">YouTube Link or Video ID <span style="color:#dc2626">*</span></label>
            <input id="lecYoutubeUrl" name="youtubeUrl" type="text" placeholder="https://www.youtube.com/watch?v=dQw4w9WgXcQ" required>
            <div class="dev-hint" id="videoIdHint">Paste a full YouTube URL (watch, youtu.be, embed, shorts) or a raw video ID.</div>
          </div>

          <div>
            <label for="lecOrder">Sort Order</label>
            <input id="lecOrder" name="order" type="number" value="0">
          </div>

          <div>
            <label for="lecTier">Access Tier <span style="color:#dc2626">*</span></label>
            <select id="lecTier" name="tier">
              <option value="basic">Basic</option>
              <option value="premium" selected>Premium</option>
              <option value="developer">Developer</option>
            </select>
          </div>

          <div class="full">
            <label for="lecDescription">Description</label>
            <textarea id="lecDescription" name="description" maxlength="500" placeholder="A short summary of what this lecture covers..."></textarea>
          </div>

          <div class="form-actions">
            <button type="button" id="lecCancelEditBtn" style="display:none; background:transparent; color:inherit; border:1px solid rgba(0,0,0,.15);">Cancel Edit</button>
            <button type="submit" id="lecSubmitBtn">Add Lecture</button>
          </div>
        </form>

        <div class="lecture-preview">
          <div class="lecture-preview-thumb" id="previewThumbWrap">
            <div class="lecture-preview-placeholder" id="previewPlaceholder">Thumbnail preview</div>
          </div>
          <div class="lecture-preview-body">
            <div class="lecture-preview-meta">
              <span class="lecture-preview-tag" id="previewClassSubject">Subject · Class</span>
              <span class="lecture-preview-tier" id="previewTier">premium</span>
            </div>
            <div class="lecture-preview-title" id="previewTitle">Lecture Title</div>
            <div class="lecture-preview-desc" id="previewDesc">The lecture description will appear here.</div>
          </div>
        </div>
      </div>

      <div class="manage-lectures">
        <div class="manage-lectures-header">
          <h4>📋 Manage Lectures</h4>
          <div class="custom-select" id="manageClassSelect" style="max-width:180px;">
            <button type="button" class="custom-select-trigger" id="manageClassSelectTrigger" aria-haspopup="listbox" aria-expanded="false">
              <span id="manageClassSelectLabel">Select class</span>
              <span class="custom-select-arrow">▾</span>
            </button>
            <ul class="custom-select-options" id="manageClassSelectOptions" role="listbox" tabindex="-1">
              <li role="option" data-value="1">Class 1</li>
              <li role="option" data-value="2">Class 2</li>
              <li role="option" data-value="3">Class 3</li>
              <li role="option" data-value="4">Class 4</li>
              <li role="option" data-value="5">Class 5</li>
              <li role="option" data-value="6">Class 6</li>
              <li role="option" data-value="7">Class 7</li>
              <li role="option" data-value="8">Class 8</li>
              <li role="option" data-value="9">Class 9</li>
              <li role="option" data-value="10">Class 10</li>
              <li role="option" data-value="11">Class 11</li>
              <li role="option" data-value="12">Class 12</li>
            </ul>
          </div>
        </div>
        <div id="manageLecturesList">
          <p class="manage-lectures-empty">Select a class above to see its lectures.</p>
        </div>
      </div>
    </div>

    <!---------------- Add Resource / PDF (developer only) ---------------->
    <div class="card dev-panel">
      <h3>📄 Add Resource <span class="dev-badge">Developer</span></h3>
      <p>Attach a Google Drive PDF/document to a class and subject. Visible only to developer-tier accounts.</p>

      <div id="resourceFormMessage"></div>

      <div class="dev-panel-grid">
        <form class="lecture-form" id="addResourceForm">
          <input type="hidden" id="resEditId" value="">

          <div>
            <label for="resClassNum">Class <span style="color:#dc2626">*</span></label>
            <div class="custom-select" id="resClassSelect">
              <button type="button" class="custom-select-trigger" id="resClassSelectTrigger" aria-haspopup="listbox" aria-expanded="false">
                <span id="resClassSelectLabel">Select class</span>
                <span class="custom-select-arrow">▾</span>
              </button>
              <ul class="custom-select-options" id="resClassSelectOptions" role="listbox" tabindex="-1">
                <li role="option" data-value="1">Class 1</li>
                <li role="option" data-value="2">Class 2</li>
                <li role="option" data-value="3">Class 3</li>
                <li role="option" data-value="4">Class 4</li>
                <li role="option" data-value="5">Class 5</li>
                <li role="option" data-value="6">Class 6</li>
                <li role="option" data-value="7">Class 7</li>
                <li role="option" data-value="8">Class 8</li>
                <li role="option" data-value="9">Class 9</li>
                <li role="option" data-value="10">Class 10</li>
                <li role="option" data-value="11">Class 11</li>
                <li role="option" data-value="12">Class 12</li>
              </ul>
            </div>
            <input type="hidden" id="resClassNum" name="classNum" required>
          </div>

          <div>
            <label for="resSubject">Subject <span style="color:#dc2626">*</span></label>
            <input id="resSubject" name="subject" type="text" placeholder="Mathematics" required>
          </div>

          <div class="full">
            <label for="resTitle">Resource Title <span style="color:#dc2626">*</span></label>
            <input id="resTitle" name="title" type="text" placeholder="Chapter 3 Notes" required>
          </div>

          <div class="full">
            <label for="resDriveLink">Google Drive Link <span style="color:#dc2626">*</span></label>
            <input id="resDriveLink" name="driveLink" type="text" placeholder="https://drive.google.com/file/d/..." required>
          </div>

          <div>
            <label for="resFileType">File Type</label>
            <select id="resFileType" name="fileType">
              <option value="pdf" selected>PDF</option>
              <option value="doc">Doc</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="resOrder">Sort Order</label>
            <input id="resOrder" name="order" type="number" value="0">
          </div>

          <div>
            <label for="resTier">Access Tier <span style="color:#dc2626">*</span></label>
            <select id="resTier" name="tier">
              <option value="basic">Basic</option>
              <option value="premium" selected>Premium</option>
              <option value="developer">Developer</option>
            </select>
          </div>

          <div class="full">
            <label for="resDescription">Description</label>
            <textarea id="resDescription" name="description" maxlength="500" placeholder="A short summary of what this document covers..."></textarea>
          </div>

          <div class="form-actions">
            <button type="button" id="resCancelEditBtn" style="display:none; background:transparent; color:inherit; border:1px solid rgba(0,0,0,.15);">Cancel Edit</button>
            <button type="submit" id="resSubmitBtn">Add Resource</button>
          </div>
        </form>

        <div class="lecture-preview">
          <div class="lecture-preview-thumb" id="resPreviewThumbWrap">
            <div class="lecture-preview-placeholder" id="resPreviewPlaceholder">📄</div>
          </div>
          <div class="lecture-preview-body">
            <div class="lecture-preview-meta">
              <span class="lecture-preview-tag" id="resPreviewClassSubject">Subject · Class</span>
              <span class="lecture-preview-tier" id="resPreviewTier">premium</span>
            </div>
            <div class="lecture-preview-title" id="resPreviewTitle">Resource Title</div>
            <div class="lecture-preview-desc" id="resPreviewDesc">The description will appear here.</div>
          </div>
        </div>
      </div>

      <div class="manage-lectures">
        <div class="manage-lectures-header">
          <h4>📋 Manage Resources</h4>
          <div class="custom-select" id="manageResClassSelect" style="max-width:180px;">
            <button type="button" class="custom-select-trigger" id="manageResClassSelectTrigger" aria-haspopup="listbox" aria-expanded="false">
              <span id="manageResClassSelectLabel">Select class</span>
              <span class="custom-select-arrow">▾</span>
            </button>
            <ul class="custom-select-options" id="manageResClassSelectOptions" role="listbox" tabindex="-1">
              <li role="option" data-value="1">Class 1</li>
              <li role="option" data-value="2">Class 2</li>
              <li role="option" data-value="3">Class 3</li>
              <li role="option" data-value="4">Class 4</li>
              <li role="option" data-value="5">Class 5</li>
              <li role="option" data-value="6">Class 6</li>
              <li role="option" data-value="7">Class 7</li>
              <li role="option" data-value="8">Class 8</li>
              <li role="option" data-value="9">Class 9</li>
              <li role="option" data-value="10">Class 10</li>
