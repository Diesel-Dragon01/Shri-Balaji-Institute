}

// ---- Add/Edit Lecture (developer only) ----
// Pulls the 11-char YouTube video ID out of any common URL shape, or accepts a raw ID.
function extractVideoId(input) {
  const value = (input || "").trim();
  if (!value) return "";

  if (/^[a-zA-Z0-9_-]{11}$/.test(value)) return value;

  try {
    const url = new URL(value);
    if (url.hostname.includes("youtu.be")) {
      return url.pathname.slice(1).split("/")[0];
    }
    if (url.hostname.includes("youtube.com")) {
      if (url.pathname === "/watch") return url.searchParams.get("v") || "";
      if (url.pathname.startsWith("/embed/")) return url.pathname.split("/embed/")[1]?.split("/")[0] || "";
      if (url.pathname.startsWith("/shorts/")) return url.pathname.split("/shorts/")[1]?.split("/")[0] || "";
    }
  } catch {
    // not a valid URL
  }
  return "";
}

const lectureForm = document.getElementById("addLectureForm");
if (lectureForm) {
  const youtubeInput = document.getElementById("lecYoutubeUrl");
  const videoIdHint = document.getElementById("videoIdHint");
  const editIdInput = document.getElementById("lecEditId");
  const submitBtn = document.getElementById("lecSubmitBtn");
  const cancelEditBtn = document.getElementById("lecCancelEditBtn");

  // ---- Custom class dropdown (Add/Edit form) ----
  const classSelect = document.getElementById("classSelect");
  const classSelectTrigger = document.getElementById("classSelectTrigger");
  const classSelectLabel = document.getElementById("classSelectLabel");
  const classSelectOptions = document.getElementById("classSelectOptions");
  const lecClassNumInput = document.getElementById("lecClassNum");

  function closeClassSelect() {
    classSelect.classList.remove("open");
    classSelectTrigger.setAttribute("aria-expanded", "false");
  }
  function openClassSelect() {
    classSelect.classList.add("open");
    classSelectTrigger.setAttribute("aria-expanded", "true");
  }
  classSelectTrigger.addEventListener("click", () => {
    classSelect.classList.contains("open") ? closeClassSelect() : openClassSelect();
  });
  classSelectOptions.querySelectorAll("li").forEach(option => {
    option.addEventListener("click", () => {
      lecClassNumInput.value = option.dataset.value;
      classSelectLabel.textContent = option.textContent;
      classSelectOptions.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      option.classList.add("active");
      closeClassSelect();
      updatePreview();
    });
  });

  function resetClassSelect() {
    lecClassNumInput.value = "";
    classSelectLabel.textContent = "Select class";
    classSelectOptions.querySelectorAll("li").forEach(li => li.classList.remove("active"));
    closeClassSelect();
  }

  function setClassSelectValue(classNum) {
    lecClassNumInput.value = classNum;
    const match = [...classSelectOptions.querySelectorAll("li")].find(li => li.dataset.value == classNum);
    classSelectOptions.querySelectorAll("li").forEach(li => li.classList.remove("active"));
    if (match) {
      classSelectLabel.textContent = match.textContent;
      match.classList.add("active");
    }
  }

  // ---- Custom class dropdown (Manage list filter) ----
  const manageClassSelect = document.getElementById("manageClassSelect");
  const manageClassSelectTrigger = document.getElementById("manageClassSelectTrigger");
  const manageClassSelectLabel = document.getElementById("manageClassSelectLabel");
  const manageClassSelectOptions = document.getElementById("manageClassSelectOptions");

  function closeManageClassSelect() {
    manageClassSelect.classList.remove("open");
    manageClassSelectTrigger.setAttribute("aria-expanded", "false");
  }
  manageClassSelectTrigger.addEventListener("click", () => {
    if (manageClassSelect.classList.contains("open")) {
      closeManageClassSelect();
    } else {
      manageClassSelect.classList.add("open");
      manageClassSelectTrigger.setAttribute("aria-expanded", "true");
    }
  });
  manageClassSelectOptions.querySelectorAll("li").forEach(option => {
    option.addEventListener("click", () => {
      manageClassSelectLabel.textContent = option.textContent;
      manageClassSelectOptions.querySelectorAll("li").forEach(li => li.classList.remove("active"));
      option.classList.add("active");
      closeManageClassSelect();
      loadManageLectures(Number(option.dataset.value));
    });
  });

  document.addEventListener("click", (e) => {
    if (!classSelect.contains(e.target)) closeClassSelect();
    if (!manageClassSelect.contains(e.target)) closeManageClassSelect();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") { closeClassSelect(); closeManageClassSelect(); }
  });

  // ---- Live preview ----
  const previewThumbWrap = document.getElementById("previewThumbWrap");
  const previewClassSubject = document.getElementById("previewClassSubject");
  const previewTier = document.getElementById("previewTier");
  const previewTitle = document.getElementById("previewTitle");
  const previewDesc = document.getElementById("previewDesc");

  function updatePreview() {
    const classNum = document.getElementById("lecClassNum").value;
    const subject = document.getElementById("lecSubject").value.trim();
    const title = document.getElementById("lecTitle").value.trim();
    const description = document.getElementById("lecDescription").value.trim();
    const tier = document.getElementById("lecTier").value;
    const videoId = extractVideoId(youtubeInput.value);

    previewClassSubject.textContent = `${subject || "Subject"}${classNum ? " · Class " + classNum : ""}`;
    previewTier.textContent = tier;
    previewTitle.textContent = title || "Lecture Title";
    previewDesc.textContent = description || "The lecture description will appear here.";

    if (videoId) {
      previewThumbWrap.innerHTML = `<img src="https://img.youtube.com/vi/${videoId}/hqdefault.jpg" alt="${title || 'Lecture thumbnail'}" onerror="this.parentElement.innerHTML='<div class=\\'lecture-preview-placeholder\\'>Unable to load thumbnail</div>'">`;
    } else {
      previewThumbWrap.innerHTML = `<div class="lecture-preview-placeholder">Thumbnail preview</div>`;
    }
  }

  ["lecSubject", "lecTitle", "lecDescription", "lecTier"].forEach(id => {
    document.getElementById(id).addEventListener("input", updatePreview);
  });

  youtubeInput.addEventListener("input", () => {
    const id = extractVideoId(youtubeInput.value);
    videoIdHint.textContent = id
      ? `Detected video ID: ${id}`
      : "Paste a full YouTube URL (watch, youtu.be, embed, shorts) or a raw video ID.";
    updatePreview();
  });

  // ---- Edit mode ----
  function enterEditMode(lecture) {
    editIdInput.value = lecture._id;
    setClassSelectValue(lecture.classNum);
    document.getElementById("lecSubject").value = lecture.subject || "";
    document.getElementById("lecTitle").value = lecture.title || "";
    document.getElementById("lecDescription").value = lecture.description || "";
    document.getElementById("lecOrder").value = lecture.order || 0;
    document.getElementById("lecTier").value = lecture.tier || "premium";
    youtubeInput.value = lecture.videoId || "";
    videoIdHint.textContent = `Detected video ID: ${lecture.videoId}`;

    submitBtn.textContent = "Update Lecture";
    cancelEditBtn.style.display = "inline-block";
    updatePreview();

    document.getElementById("addLectureForm").scrollIntoView({ behavior: "smooth", block: "start" });
  }

  function exitEditMode() {
    editIdInput.value = "";
    lectureForm.reset();
    resetClassSelect();
    document.getElementById("lecTier").value = "premium";
    document.getElementById("lecOrder").value = 0;
    videoIdHint.textContent = "Paste a full YouTube URL (watch, youtu.be, embed, shorts) or a raw video ID.";
    submitBtn.textContent = "Add Lecture";
    cancelEditBtn.style.display = "none";
    updatePreview();
  }

  cancelEditBtn.addEventListener("click", exitEditMode);

  // ---- Submit (create or update) ----
  lectureForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const videoId = extractVideoId(youtubeInput.value);

    if (!videoId) {
      showToast("❌ Couldn't find a video ID in that link.", "error");
      return;
    }

    const payload = {
      classNum: Number(document.getElementById("lecClassNum").value),
      subject: document.getElementById("lecSubject").value.trim(),
      title: document.getElementById("lecTitle").value.trim(),
      description: document.getElementById("lecDescription").value.trim(),
      videoId,
      order: Number(document.getElementById("lecOrder").value) || 0,
      tier: document.getElementById("lecTier").value
    };

    if (!payload.classNum || !payload.subject || !payload.title) {
      showToast("❌ Please fill in class, subject, and title.", "error");
      return;
    }

    const editId = editIdInput.value;
    const isEditing = !!editId;

    submitBtn.disabled = true;
    submitBtn.textContent = isEditing ? "Updating..." : "Adding...";

    try {
      const res = await fetch(isEditing ? `/api/lectures/${editId}` : "/api/lectures", {
        method: isEditing ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const data = await res.json();

      if (data.success) {
        showToast(data.message || (isEditing ? "✅ Lecture updated!" : "✅ Lecture added!"));
        exitEditMode();

        // Refresh the manage list if it's currently showing this class
        const activeManageOption = manageClassSelectOptions.querySelector("li.active");
        if (activeManageOption && Number(activeManageOption.dataset.value) === payload.classNum) {
          loadManageLectures(payload.classNum);
        }
      } else {
        showToast(data.message || "❌ Failed to save lecture.", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("❌ Something went wrong.", "error");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = isEditing ? "Update Lecture" : "Add Lecture";
    }
  });

  // ---- Manage Lectures list ----
  async function loadManageLectures(classNum) {
    const list = document.getElementById("manageLecturesList");
    list.innerHTML = `<p class="manage-lectures-empty">Loading…</p>`;

    try {
      const res = await fetch(`/api/lectures/${classNum}`);
      const data = await res.json();

      if (!data.success) {
        list.innerHTML = `<p class="manage-lectures-empty">${data.message || "Could not load lectures."}</p>`;
        return;
      }

      const allLectures = Object.values(data.lectures).flat();

      if (allLectures.length === 0) {
        list.innerHTML = `<p class="manage-lectures-empty">No lectures for this class yet.</p>`;
        return;
      }

      list.innerHTML = "";
      allLectures.forEach(lecture => {
        const row = document.createElement("div");
        row.className = "manage-lecture-row";
        row.innerHTML = `
          <div class="manage-lecture-info">
            <div class="manage-lecture-title">${lecture.title}</div>
            <div class="manage-lecture-sub">${lecture.subject} · ${lecture.tier}</div>
          </div>
          <div class="manage-lecture-actions">
            <button class="manage-edit-btn" type="button">Edit</button>
            <button class="manage-delete-btn" type="button">Delete</button>
          </div>
        `;
        row.querySelector(".manage-edit-btn").addEventListener("click", () => enterEditMode(lecture));
        row.querySelector(".manage-delete-btn").addEventListener("click", () => deleteLecture(lecture._id, classNum));
        list.appendChild(row);
      });
    } catch (err) {
      console.error(err);
      list.innerHTML = `<p class="manage-lectures-empty">Something went wrong loading lectures.</p>`;
    }
  }

  async function deleteLecture(id, classNum) {
    if (!confirm("Delete this lecture? This can't be undone.")) return;

    try {
      const res = await fetch(`/api/lectures/${id}`, { method: "DELETE" });
      const data = await res.json();

      if (data.success) {
        showToast(data.message || "🗑️ Lecture deleted.");
        loadManageLectures(classNum);
        if (editIdInput.value === id) exitEditMode();
      } else {
        showToast(data.message || "❌ Failed to delete lecture.", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("❌ Something went wrong.", "error");
    }
  }

  updatePreview();
}

// ---- Add/Edit Resource (developer only) ----
