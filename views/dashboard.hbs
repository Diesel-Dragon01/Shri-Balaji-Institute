        showToast(data.message || (isEditing ? "✅ Resource updated!" : "✅ Resource added!"));
        exitResEditMode();

        const activeManageOption = manageResClassSelectOptions.querySelector("li.active");
        if (activeManageOption && Number(activeManageOption.dataset.value) === payload.classNum) {
          loadManageResources(payload.classNum);
        }
      } else {
        showToast(data.message || "❌ Failed to save resource.", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("❌ Something went wrong.", "error");
    } finally {
      resSubmitBtn.disabled = false;
      resSubmitBtn.textContent = isEditing ? "Update Resource" : "Add Resource";
    }
  });

  // ---- Manage Resources list ----
  async function loadManageResources(classNum) {
    const list = document.getElementById("manageResourcesList");
    list.innerHTML = `<p class="manage-lectures-empty">Loading…</p>`;

    try {
      const res = await fetch(`/api/resources/${classNum}`);
      const data = await res.json();

      if (!data.success) {
        list.innerHTML = `<p class="manage-lectures-empty">${data.message || "Could not load resources."}</p>`;
        return;
      }

      const allResources = Object.values(data.resources).flat();

      if (allResources.length === 0) {
        list.innerHTML = `<p class="manage-lectures-empty">No resources for this class yet.</p>`;
        return;
      }

      list.innerHTML = "";
      allResources.forEach(resource => {
        const row = document.createElement("div");
        row.className = "manage-lecture-row";
        row.innerHTML = `
          <div class="manage-lecture-info">
            <div class="manage-lecture-title">${resource.title}</div>
            <div class="manage-lecture-sub">${resource.subject} · ${resource.tier} · ${resource.fileType}</div>
          </div>
          <div class="manage-lecture-actions">
            <button class="manage-edit-btn" type="button">Edit</button>
            <button class="manage-delete-btn" type="button">Delete</button>
          </div>
        `;
        row.querySelector(".manage-edit-btn").addEventListener("click", () => enterResEditMode(resource));
        row.querySelector(".manage-delete-btn").addEventListener("click", () => deleteResource(resource._id, classNum));
        list.appendChild(row);
      });
    } catch (err) {
      console.error(err);
      list.innerHTML = `<p class="manage-lectures-empty">Something went wrong loading resources.</p>`;
    }
  }

  async function deleteResource(id, classNum) {
    if (!confirm("Delete this resource? This can't be undone.")) return;

    try {
      const res = await fetch(`/api/resources/${id}`, { method: "DELETE" });
      const data = await res.json();

      if (data.success) {
        showToast(data.message || "🗑️ Resource deleted.");
        loadManageResources(classNum);
        if (resEditIdInput.value === id) exitResEditMode();
      } else {
        showToast(data.message || "❌ Failed to delete resource.", "error");
      }
    } catch (err) {
      console.error(err);
      showToast("❌ Something went wrong.", "error");
    }
  }

  updateResPreview();
}

