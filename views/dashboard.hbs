// ---- Class Material page: open a class, render its subjects/books ----
let currentMaterialClass = null;
let currentMedium = "english";

function openClassMaterial(classNum) {
  currentMaterialClass = classNum;
  currentMedium = "english";

  const classData = NCERT_DATA[classNum];
  const label = classData ? classData.label : `Class ${classNum}`;

  document.getElementById("materialTitle").textContent = `${label} – NCERT Books`;

  // Reset the medium toggle UI to English each time a class is opened
  document.querySelectorAll("#mediumToggle button").forEach(btn => {
    btn.classList.toggle("active", btn.dataset.medium === "english");
  });

  navigate("materialPage");
  renderSubjectGrid();
}

function setMedium(medium) {
  currentMedium = medium;
  document.querySelectorAll("#mediumToggle button").forEach(btn => {
    btn.classList.toggle("active", btn.dataset.medium === medium);
  });
  renderSubjectGrid();
}

function renderSubjectGrid() {
  const grid = document.getElementById("subjectGrid");
  grid.innerHTML = "";

  const classData = NCERT_DATA[currentMaterialClass];
  const subjects = classData ? classData.subjects : [];

  if (!subjects || subjects.length === 0) {
    grid.innerHTML = `<p style="opacity:.6; font-size:14px;">No study material available for this class yet.</p>`;
    return;
  }

  subjects.forEach(subject => {
    const card = document.createElement("div");
    card.className = "subject-card";

    const heading = document.createElement("h4");
    heading.textContent = subject.name;
    card.appendChild(heading);

    subject.books.forEach(book => {
      // Fall back to the English link if this book has no Hindi edition
      const href = (currentMedium === "hindi" && book.hi) ? book.hi : book.en;

      const link = document.createElement("a");
      link.className = "book-link";
      link.href = href;
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.innerHTML = `<span>${book.name}</span><span class="go">Open PDF →</span>`;
      card.appendChild(link);
    });

    grid.appendChild(card);
  });
}
</script>
