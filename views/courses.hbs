<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Courses</title>
<style>
{{> base_styles }}

/* Page switch (class grid <-> class course list, within this file only) */
.page { display: none; }
.page.active { display: block; }

/*---------------- Class picker (matches dashboard's NCERT grid) ----------------*/
.courses-intro { margin-top: 4px; }
.courses-intro h3 { font-size: 19px; margin-bottom: 4px; }
.courses-intro p { opacity: .65; font-size: 14px; margin-bottom: 18px; }
.class-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}
.class-card {
  border: none; border-radius: 16px; padding: 22px; cursor: pointer;
  color: white; text-align: left; transition: .25s ease; font-family: inherit;
}
.class-card:hover { transform: translateY(-4px); box-shadow: 0 12px 24px rgba(0,0,0,.22); }
.class-card:focus-visible { outline: 3px solid #facc15; outline-offset: 2px; }
.class-card .class-num { font-size: 36px; font-weight: 800; line-height: 1; }
.class-card .class-label { margin-top: 6px; font-size: 13px; opacity: .85; }

/*---------------- Class lecture list ----------------*/
.back-btn {
  background: transparent; border: none; cursor: pointer; font-size: 14px;
  color: inherit; opacity: .7; margin-bottom: 14px; padding: 0;
}
.back-btn:hover { opacity: 1; }

.lecture-subject-group { margin-bottom: 28px; }
.lecture-subject-title {
  font-size: 15px; font-weight: 700; margin-bottom: 10px;
  padding-bottom: 6px; border-bottom: 1px solid rgba(0,0,0,.08);
}
body.dark .lecture-subject-title { border-bottom-color: rgba(255,255,255,.1); }

.lecture-row {
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  padding: 12px 16px; border-radius: 12px; background: rgba(0,0,0,.03); margin-bottom: 8px;
}
body.dark .lecture-row { background: rgba(255,255,255,.05); }
.lecture-info { display: flex; flex-direction: column; gap: 2px; }
.lecture-title { font-size: 14px; font-weight: 600; }
.lecture-desc { font-size: 12px; opacity: .6; }
.lecture-play-btn {
  flex-shrink: 0; border: none; border-radius: 8px; padding: 8px 16px;
  background: #1e293b; color: white; font-size: 13px; font-weight: 600; cursor: pointer; transition: .2s;
}
.lecture-play-btn:hover { opacity: .88; transform: translateY(-1px); }

.lecture-empty { text-align: center; padding: 60px 20px; opacity: .6; }
.lecture-empty .icon { font-size: 40px; margin-bottom: 12px; }

/*---------------- Mini player ---------------- */
.mini-player {
  position: fixed;
  z-index: 900;
  display: none;
  background: #111827;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 20px 45px rgba(0,0,0,.35);
  transition: width .25s ease, height .25s ease, bottom .25s ease, right .25s ease;
}
.mini-player.docked {
  position: relative;
  width: 100%;
  max-width: 900px;
  margin: 20px auto;
  height: auto;
}
.mini-player.docked .mini-player-body { aspect-ratio: 16 / 9; }
.mini-player.floating {
  bottom: 20px;
  right: 20px;
  width: 340px;
  height: 191px;
}
.mini-player-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 12px; background: #1e293b; color: white; font-size: 13px;
}
.mini-player-title {
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; margin-right: 8px;
}
.mini-player-controls { display: flex; gap: 6px; }
.mini-player-controls button {
  background: rgba(255,255,255,.1); border: none; color: white;
  width: 26px; height: 26px; border-radius: 6px; cursor: pointer; font-size: 13px;
}
.mini-player-controls button:hover { background: rgba(255,255,255,.2); }
.mini-player-body { width: 100%; height: 100%; }
.mini-player-stage { position: relative; width: 100%; height: 100%; }
.mini-player-stage iframe { width: 100%; height: 100%; border: none; display: block; }
.mini-player-watermark {
  position: absolute;
  z-index: 10;
  pointer-events: none;
  color: rgba(255,255,255,.55);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .3px;
  text-shadow: 0 1px 3px rgba(0,0,0,.7);
  padding: 4px 9px;
  border-radius: 6px;
  background: rgba(0,0,0,.15);
  top: 0; left: 0;
  will-change: transform;
}
</style>
</head>
<body class="{{#if (equal theme "dark")}}dark{{/if}}" data-username="{{username}}">

{{> navbar }}
{{> sidebar activePage="courses" }}

<!-- ================= Class picker ================= -->
<div id="classGridPage" class="page active">
  <div class="container">
    <div class="courses-intro">
      <h3>📚 My Courses</h3>
      <p>Pick a class to see its lecture videos.</p>
      <div class="class-grid">
        <button class="class-card" style="background:linear-gradient(135deg,#be185d,#ec4899);" onclick="openClass(1)">
          <div class="class-num">1</div><div class="class-label">Class 1</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#0369a1,#0ea5e9);" onclick="openClass(2)">
          <div class="class-num">2</div><div class="class-label">Class 2</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#15803d,#22c55e);" onclick="openClass(3)">
          <div class="class-num">3</div><div class="class-label">Class 3</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#a16207,#eab308);" onclick="openClass(4)">
          <div class="class-num">4</div><div class="class-label">Class 4</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#c2410c,#f97316);" onclick="openClass(5)">
          <div class="class-num">5</div><div class="class-label">Class 5</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#7e22ce,#a855f7);" onclick="openClass(6)">
          <div class="class-num">6</div><div class="class-label">Class 6</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#0f766e,#14b8a6);" onclick="openClass(7)">
          <div class="class-num">7</div><div class="class-label">Class 7</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#b91c1c,#ef4444);" onclick="openClass(8)">
          <div class="class-num">8</div><div class="class-label">Class 8</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#1e293b,#334155);" onclick="openClass(9)">
          <div class="class-num">9</div><div class="class-label">Class 9</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#047857,#059669);" onclick="openClass(10)">
          <div class="class-num">10</div><div class="class-label">Class 10</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#6d28d9,#8b5cf6);" onclick="openClass(11)">
          <div class="class-num">11</div><div class="class-label">Class 11</div>
        </button>
        <button class="class-card" style="background:linear-gradient(135deg,#b45309,#d97706);" onclick="openClass(12)">
          <div class="class-num">12</div><div class="class-label">Class 12</div>
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ================= Class lecture list ================= -->
<div id="classCoursesPage" class="page">
  <div class="container">
    <button class="back-btn" onclick="navigate('classGridPage')">← Back to Classes</button>
    <h2 id="classCoursesTitle">Class 9 – Lectures</h2>

    <div id="lectureListWrap" style="margin-top:20px;"></div>

    <!-- The mini player docks itself here when expanded; it moves to a fixed corner when minimized -->
    <div id="playerAnchor"></div>
  </div>
</div>

{{> footer }}

<!-- ============= Mini Player ============= -->
<div id="miniPlayer" class="mini-player">
  <div class="mini-player-header">
    <span id="miniPlayerTitle" class="mini-player-title">Lecture</span>
    <div class="mini-player-controls">
      <button id="miniPlayerToggle" onclick="toggleMiniPlayerSize()" title="Minimize/Expand">▁</button>
      <button id="miniPlayerClose" onclick="closeMiniPlayer()" title="Close">✕</button>
    </div>
  </div>
  <div id="miniPlayerBody" class="mini-player-body"></div>
</div>

{{> shared_scripts }}

<script>
function navigate(page) {
  document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
  const target = document.getElementById(page);
  if (target) target.classList.add("active");
  document.getElementById("sidebar").classList.remove("active");
  document.getElementById("overlay").classList.remove("active");
}

let currentClass = null;

async function openClass(classNum) {
  currentClass = classNum;
  document.getElementById("classCoursesTitle").textContent = `Class ${classNum} – Lectures`;
  navigate("classCoursesPage");
  await loadLectures(classNum);
}

async function loadLectures(classNum) {
  const wrap = document.getElementById("lectureListWrap");
  wrap.innerHTML = `<p style="opacity:.6; font-size:14px;">Loading lectures…</p>`;

  try {
    const response = await fetch(`/api/lectures/${classNum}`);
    const data = await response.json();

    if (!data.success) {
      wrap.innerHTML = `<div class="lecture-empty"><div class="icon">⚠️</div><p>${data.message || "Could not load lectures."}</p></div>`;
      return;
    }

    const subjects = Object.keys(data.lectures);

    if (subjects.length === 0) {
      wrap.innerHTML = `<div class="lecture-empty"><div class="icon">🗂️</div><p>No lectures available for this class yet.</p></div>`;
      return;
    }

    wrap.innerHTML = "";
    subjects.forEach(subject => {
      const group = document.createElement("div");
      group.className = "lecture-subject-group";

      const title = document.createElement("div");
      title.className = "lecture-subject-title";
      title.textContent = subject;
      group.appendChild(title);

      data.lectures[subject].forEach(lecture => {
        const row = document.createElement("div");
        row.className = "lecture-row";
        row.innerHTML = `
          <div class="lecture-info">
            <div class="lecture-title">${lecture.title}</div>
            ${lecture.description ? `<div class="lecture-desc">${lecture.description}</div>` : ""}
          </div>
          <button class="lecture-play-btn">▶ Play</button>
        `;
        row.querySelector(".lecture-play-btn").addEventListener("click", () => {
          playLecture(lecture.videoId, lecture.title);
        });
        group.appendChild(row);
      });

      wrap.appendChild(group);
    });
  } catch (err) {
    console.log(err);
    wrap.innerHTML = `<div class="lecture-empty"><div class="icon">⚠️</div><p>Something went wrong loading lectures.</p></div>`;
  }
}

// ---- Mini player ----
let ytPlayer = null;
let ytApiReady = false;
let ytPlayerReady = false;      // true only after onReady actually fires
let pendingVideo = null;        // { videoId, title } — most recent request not yet applied
let watermarkAnimId = null;

(function loadYouTubeAPI() {
  const tag = document.createElement('script');
  tag.src = "https://www.youtube.com/iframe_api";
  document.head.appendChild(tag);
})();

window.onYouTubeIframeAPIReady = function () {
  ytApiReady = true;
  if (pendingVideo) {
    createPlayer(pendingVideo.videoId, pendingVideo.title);
  }
};

function startWatermarkDrift() {
  const wm = document.getElementById('watermarkLabel');
  const stage = wm ? wm.closest('.mini-player-stage') : null;
  if (!wm || !stage) return;

  stopWatermarkDrift();

  let x = 10, y = 10;
  const speed = 0.6;
  let vx = speed, vy = speed;

  function step() {
    const maxX = stage.clientWidth - wm.offsetWidth;
    const maxY = stage.clientHeight - wm.offsetHeight;

    if (maxX <= 0 || maxY <= 0) {
      watermarkAnimId = requestAnimationFrame(step);
      return;
    }

    x += vx;
    y += vy;

    if (x <= 0) { x = 0; vx = Math.abs(vx); }
    else if (x >= maxX) { x = maxX; vx = -Math.abs(vx); }

    if (y <= 0) { y = 0; vy = Math.abs(vy); }
    else if (y >= maxY) { y = maxY; vy = -Math.abs(vy); }

    wm.style.transform = `translate(${x}px, ${y}px)`;
    watermarkAnimId = requestAnimationFrame(step);
  }

  watermarkAnimId = requestAnimationFrame(step);
}

function stopWatermarkDrift() {
  if (watermarkAnimId) {
    cancelAnimationFrame(watermarkAnimId);
    watermarkAnimId = null;
  }
}

function dockPlayerUI(title) {
  const player = document.getElementById('miniPlayer');
  const titleEl = document.getElementById('miniPlayerTitle');

  player.style.display = 'block';
  player.classList.remove('floating');
  player.classList.add('docked');
  titleEl.textContent = title;

  const anchor = document.getElementById('playerAnchor');
  if (anchor) anchor.appendChild(player);
}

function createPlayer(videoId, title) {
  const body = document.getElementById('miniPlayerBody');
  const username = document.body.dataset.username || 'Guest';

  // Always tear down any existing player before making a new one —
  // loadVideoById() can silently fail to reach the iframe on some
  // origins (e.g. non-standard localhost ports), so we don't rely on it.
  if (ytPlayer && typeof ytPlayer.destroy === 'function') {
    ytPlayer.destroy();
  }
  ytPlayer = null;
  ytPlayerReady = false;
  stopWatermarkDrift();

  body.innerHTML = `
    <div class="mini-player-stage">
      <div id="ytPlayerTarget"></div>
      <div id="watermarkLabel" class="mini-player-watermark">${username}</div>
    </div>
  `;

  ytPlayer = new YT.Player('ytPlayerTarget', {
    videoId: videoId,
    playerVars: { autoplay: 1, rel: 0 },
    events: {
      onReady: () => {
        ytPlayerReady = true;
        pendingVideo = null;
      }
    }
  });

  startWatermarkDrift();
}

function playLecture(videoId, title) {
  dockPlayerUI(title);

  if (!ytApiReady) {
    pendingVideo = { videoId, title };
    return;
  }

  // Always (re)create the player for the requested video instead of
  // trying to reuse the existing one via loadVideoById.
  pendingVideo = { videoId, title };
  createPlayer(videoId, title);
}

function toggleMiniPlayerSize() {
  const player = document.getElementById('miniPlayer');
  const isDocked = player.classList.contains('docked');

  if (isDocked) {
    player.classList.remove('docked');
    player.classList.add('floating');
    document.body.appendChild(player);
    document.getElementById('miniPlayerToggle').textContent = '⬜';
  } else {
    player.classList.remove('floating');
    player.classList.add('docked');
    const anchor = document.getElementById('playerAnchor');
    if (anchor) anchor.appendChild(player);
    document.getElementById('miniPlayerToggle').textContent = '▁';
  }
}

function closeMiniPlayer() {
  const player = document.getElementById('miniPlayer');
  player.style.display = 'none';
  if (ytPlayer) ytPlayer.stopVideo();
  stopWatermarkDrift();
}
</script>
</body>
</html>
