<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Upgrade to Premium</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
            background: radial-gradient(circle at 20% 20%, #1e1b4b 0%, #0f172a 45%, #030712 100%);
        }

        /* Ambient glow orbs floating behind the card */
        body::before, body::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: .35;
            pointer-events: none;
        }
        body::before {
            width: 420px; height: 420px;
            top: -120px; left: -100px;
            background: #6d28d9;
            animation: float1 9s ease-in-out infinite;
        }
        body::after {
            width: 380px; height: 380px;
            bottom: -140px; right: -100px;
            background: #facc15;
            animation: float2 11s ease-in-out infinite;
        }
        @keyframes float1 {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(40px, 30px); }
        }
        @keyframes float2 {
            0%, 100% { transform: translate(0, 0); }
            50% { transform: translate(-30px, -40px); }
        }

        @property --border-angle {
            syntax: '<angle>';
            inherits: false;
            initial-value: 0deg;
        }

        .card {
            position: relative;
            width: 450px;
            z-index: 1;

            background: rgba(17, 24, 39, 0.72);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            padding: 46px 40px 40px;
            border-radius: 22px;
            text-align: center;

            color: #f1f5f9;
            box-shadow: 0 30px 60px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.04) inset;
            animation: rise .5s ease both;
        }
        @keyframes rise {
            from { opacity: 0; transform: translateY(18px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Rotating gold glow border, same premium motif used across the app */
        .card::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 22px;
            padding: 2px;
            background: conic-gradient(
                from var(--border-angle),
                #d4af37 0deg,
                #d4af37 300deg,
                #fff9c4 320deg,
                #fffbe6 330deg,
                #fff9c4 340deg,
                #d4af37 360deg
            );
            -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            -webkit-mask-composite: xor;
            mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
            mask-composite: exclude;
            filter: drop-shadow(0 0 6px rgba(255,245,183,0.55));
            animation: spin-border 4s linear infinite;
            pointer-events: none;
        }
        @keyframes spin-border { to { --border-angle: 360deg; } }

        .badge-icon {
            width: 64px; height: 64px;
            margin: 0 auto 18px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 30px;
            background: linear-gradient(135deg, #facc15, #f59e0b);
            box-shadow: 0 0 24px rgba(250,204,21,.45);
        }

        h1 {
            font-size: 24px;
            margin-bottom: 8px;
            background: linear-gradient(90deg, #facc15, #fde68a);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .current-tier {
            display: inline-block;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            padding: 5px 14px;
            border-radius: 999px;
            background: rgba(255,255,255,.08);
            color: #cbd5e1;
            margin-bottom: 22px;
        }
        .current-tier strong { color: #facc15; }

        .price {
            font-size: 42px;
            font-weight: 800;
            margin-bottom: 4px;
            background: linear-gradient(90deg, #a78bfa, #818cf8);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }
        .price-note {
            font-size: 12px;
            color: #94a3b8;
            margin-bottom: 26px;
        }

        ul {
            list-style: none;
            text-align: left;
            margin-bottom: 30px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 14px;
            color: #e2e8f0;
            line-height: 1.4;
        }
        li::before {
            content: "✓";
            flex-shrink: 0;
            width: 20px; height: 20px;
            border-radius: 50%;
            background: rgba(250,204,21,.15);
            color: #facc15;
            font-size: 12px;
            font-weight: 800;
            display: flex; align-items: center; justify-content: center;
            margin-top: 1px;
        }

        button {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 12px;
            background: linear-gradient(135deg, #facc15, #f59e0b);
            color: #1e1b4b;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: transform .2s ease, box-shadow .2s ease;
            box-shadow: 0 10px 25px rgba(250,204,21,.25);
        }
        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(250,204,21,.4);
        }
        button:active {
            transform: translateY(0);
        }
        button:disabled {
            opacity: .7;
            cursor: not-allowed;
            transform: none;
        }
    </style>
</head>
<body>

    <div class="card">

        <div class="badge-icon">💎</div>

        <h1>Upgrade to Premium</h1>

        <p class="current-tier">
            Current Tier: <strong>{{tier}}</strong>
        </p>

        <div class="price">₹99<span style="font-size:16px; font-weight:600;">/month</span></div>
        <p class="price-note">Cancel anytime, no questions asked</p>

        <ul>
            <li>Enhanced dashboard experience with advanced UI styling</li>
            <li>Access to premium learning content and structured modules</li>
            <li>Verified premium account badge</li>
            <li>Direct support contact available in the footer</li>
        </ul>

        <button id="upgradeBtn">
            Upgrade Now
        </button>

    </div>

    <script>
        document.getElementById('upgradeBtn')
        .addEventListener('click', async (e) => {
            const btn = e.currentTarget;
            btn.disabled = true;
            btn.textContent = "Upgrading…";

            try {
                const response = await fetch('/upgrade-premium', {
                    method: 'POST'
                });

                if (response.ok) {
                    window.location.href = '/dashboard?premium=success';
                } else {
                    btn.disabled = false;
                    btn.textContent = "Upgrade Now";
                }
            } catch (err) {
                console.log(err);
                btn.disabled = false;
                btn.textContent = "Upgrade Now";
            }
        });
    </script>

</body>
</html>
